---
import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/front/Navbar.astro";
import Footer from "@/components/front/Footer.astro";
import StickySocial from "@/components/front/StickySocial.astro";
import { abs, localizedPath, hreflangAlternates, organizationJsonLd } from "@/lib/seo";
import type { Locale } from "@/lib/i18n";
import type { SettingsGeneral, SettingsSocial } from "@/lib/types";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  path: string; // chemin logique sans préfixe de langue
  general: SettingsGeneral;
  social: SettingsSocial;
  jsonLd?: object[];
  ogImage?: string;
}
const {
  title,
  description = "L'agence USM Football propulse la carrière des footballeurs professionnels.",
  locale,
  path,
  general,
  social,
  jsonLd = [],
  ogImage = abs("/Assets/apple-touch-icon.png"),
} = Astro.props;

const canonical = abs(localizedPath(locale, path));
const alternates = hreflangAlternates(path);
const allJsonLd = [organizationJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}

    <link rel="icon" type="image/png" sizes="32x32" href="/Assets/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/Assets/favicon-16.png" />
    <link rel="apple-touch-icon" href="/Assets/apple-touch-icon.png" />

    <link rel="stylesheet" href="/site.css" />
    {allJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    <StickySocial social={social} />
    <Navbar locale={locale} path={path} general={general} />
    <slot />
    <Footer locale={locale} social={social} />

    <style is:global>
      /* En prod, les icônes sociales étaient masquées (display:none) tant que le JS
         Firebase ne validait pas les liens. En v2 les liens sont injectés au build
         (déjà valides) -> on les affiche directement. */
      .sticky-social-bar .sticky-icon { display: inline-flex; }
    </style>

    <script>
      // Interactions globales (re-jouées à chaque navigation View Transitions).
      function initShell() {
        const menuBtn = document.getElementById("mobile-menu-btn");
        const closeBtn = document.getElementById("close-menu-btn");
        const navLinks = document.getElementById("nav-links");
        if (menuBtn && navLinks && !menuBtn.dataset.bound) {
          menuBtn.dataset.bound = "1";
          menuBtn.addEventListener("click", () => navLinks.classList.add("active"));
          closeBtn?.addEventListener("click", () => navLinks.classList.remove("active"));
          navLinks.querySelectorAll("a").forEach((a) =>
            a.addEventListener("click", () => navLinks.classList.remove("active"))
          );
        }
        const langSelect = document.getElementById("lang-select") as HTMLSelectElement | null;
        if (langSelect && !langSelect.dataset.bound) {
          langSelect.dataset.bound = "1";
          langSelect.addEventListener("change", () => {
            const opt = langSelect.selectedOptions[0];
            const href = opt?.getAttribute("data-href");
            if (href) window.location.href = href;
          });
        }
      }
      initShell();
      document.addEventListener("astro:page-load", initShell);
    </script>

    <script>
      // Sélecteur de compte social (USM / Christophe) : popover au clic quand 2 comptes
      // sont définis ; sinon le lien direct s'ouvre normalement. Lié une seule fois
      // (le listener sur document survit aux navigations View Transitions).
      (function () {
        const w = window as any;
        if (w.__usmSocialPicker) return;
        w.__usmSocialPicker = true;

        function closePicker() {
          document.querySelector(".social-choice-popover")?.remove();
        }

        function showPicker(anchor: HTMLElement, title: string, choices: { label: string; url: string }[]) {
          closePicker();
          const picker = document.createElement("div");
          picker.className = "social-choice-popover";
          picker.setAttribute("role", "dialog");
          picker.setAttribute("aria-label", title + " — choisir un compte");

          const titleEl = document.createElement("div");
          titleEl.className = "social-choice-title";
          titleEl.textContent = title;
          picker.appendChild(titleEl);

          const actions = document.createElement("div");
          actions.className = "social-choice-actions";
          choices.forEach((c) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "social-choice-btn";
            btn.textContent = c.label;
            btn.addEventListener("click", () => {
              closePicker();
              if (c.url) window.open(c.url, "_blank", "noopener,noreferrer");
            });
            actions.appendChild(btn);
          });
          picker.appendChild(actions);
          document.body.appendChild(picker);

          const rect = anchor.getBoundingClientRect();
          const pr = picker.getBoundingClientRect();
          const pad = 12;
          const left = Math.min(
            Math.max(pad, rect.left + rect.width / 2 - pr.width / 2),
            window.innerWidth - pr.width - pad
          );
          const above = rect.top - pr.height - 12;
          const top = above > pad ? above : Math.min(rect.bottom + 12, window.innerHeight - pr.height - pad);
          picker.style.left = left + "px";
          picker.style.top = Math.max(pad, top) + "px";
        }

        document.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const link = target.closest("a[data-social-platform]") as HTMLAnchorElement | null;
          if (!link) {
            if (!target.closest(".social-choice-popover")) closePicker();
            return;
          }
          let choices: { label: string; url: string }[] = [];
          try { choices = JSON.parse(link.dataset.socialChoices || "[]"); } catch (_) { /* ignore */ }
          if (choices.length <= 1) return; // un seul compte -> lien direct normal
          e.preventDefault();
          showPicker(link, link.dataset.socialTitle || "", choices);
        });

        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closePicker(); });
        window.addEventListener("scroll", closePicker, true);
        window.addEventListener("resize", closePicker);
        document.addEventListener("astro:before-swap", closePicker);
      })();
    </script>
  </body>
</html>
