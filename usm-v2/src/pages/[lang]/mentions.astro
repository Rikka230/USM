---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Mentions from "@/components/pages/Mentions.astro";
import { loadSiteContent } from "@/lib/content";
import type { Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return ["en", "es", "pt"].map((l) => ({ params: { lang: l } }));
}

const locale = Astro.params.lang as Locale;
const content = await loadSiteContent();
const title = "Mentions Légales | USM Football";
---

<SiteLayout
  locale={locale}
  path="/mentions"
  title={title}
  description="Mentions légales de l'agence USM Football."
  general={content.general}
  social={content.social}
>
  <Mentions locale={locale} content={content} />
</SiteLayout>
