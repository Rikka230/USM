---
import SiteLayout from "@/layouts/SiteLayout.astro";
import RecrutementPage from "@/components/pages/RecrutementPage.astro";
import { loadSiteContent } from "@/lib/content";
import { LOCALES, DEFAULT_LOCALE, t, type Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((l) => ({ params: { lang: l } }));
}

const locale = Astro.params.lang as Locale;
const content = await loadSiteContent();
const title = `${t(locale, "jobs_title")} | USM Football`;
---

<SiteLayout
  locale={locale}
  path="/recrutement"
  title={title}
  description={t(locale, "jobs_description")}
  general={content.general}
  social={content.social}
>
  <RecrutementPage locale={locale} />
</SiteLayout>
