---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadSiteContent, playersByCategory } from "@/lib/content";
import { localizedField } from "@/lib/i18n";

const content = await loadSiteContent();
const byCat = playersByCategory(content.players);
const stat1 = content.general?.stat1 ?? "—";
const firstService = content.services[0]
  ? localizedField(content.services[0], "title", "fr")
  : "—";
---

<BaseLayout title="USM Football | Agence de Gestion de Carrière Sportive">
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col items-center justify-center gap-8 px-6 py-20 text-center">
    <p class="text-sm uppercase tracking-[0.4em] text-muted-foreground">Since 1998</p>
    <h1 class="font-display text-5xl font-black uppercase sm:text-7xl">
      USM F<span class="text-primary">OO</span>TBALL
    </h1>
    <span class="inline-flex items-center rounded-full border border-primary/40 bg-primary/10 px-4 py-1 text-sm text-primary">
      Jalon 2 — pipeline données (build-time Firestore)
    </span>

    <div class="grid w-full grid-cols-2 gap-4 sm:grid-cols-3">
      {[
        ["Services", content.services.length],
        ["Joueurs", content.players.length],
        ["Vidéos presse", content.presseVideos.length],
        ["Articles presse", content.presseArticles.length],
        ["Marquee", content.marquee.length],
        ["Stat 1", stat1],
      ].map(([label, value]) => (
        <div class="rounded-xl border border-border bg-card p-4">
          <div class="text-2xl font-bold text-primary">{value}</div>
          <div class="text-xs uppercase tracking-wide text-muted-foreground">{label}</div>
        </div>
      ))}
    </div>

    <div class="w-full rounded-xl border border-border bg-card p-4 text-left text-sm">
      <p class="mb-2 font-semibold">Joueurs par catégorie</p>
      <ul class="grid grid-cols-2 gap-1 text-muted-foreground sm:grid-cols-3">
        {Object.entries(byCat).map(([cat, list]) => (
          <li>{cat} : <span class="text-foreground">{list.length}</span></li>
        ))}
      </ul>
      <p class="mt-3 text-muted-foreground">1er service : <span class="text-foreground">{firstService}</span></p>
    </div>
  </main>
</BaseLayout>
