---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ServicePage from "@/components/pages/ServicePage.astro";
import { loadSiteContent, serviceSlugMap } from "@/lib/content";
import { localizedField, type Locale } from "@/lib/i18n";
import { localizedPath, abs, serviceJsonLd } from "@/lib/seo";
import type { Service } from "@/lib/types";

export async function getStaticPaths() {
  const content = await loadSiteContent();
  const map = serviceSlugMap(content.services);
  return Array.from(map.entries()).map(([slug, service]) => ({
    params: { slug },
    props: { service },
  }));
}

const locale: Locale = "fr";
const { slug } = Astro.params;
const { service } = Astro.props as { service: Service };
const content = await loadSiteContent();

const title = localizedField(service, "title", locale);
const desc = localizedField(service, "desc", locale);
const path = `/services/${slug}`;

const jsonLd = [
  serviceJsonLd({
    name: title,
    description: desc,
    url: abs(localizedPath(locale, path)),
    image: service.image_url,
  }),
];
---

<SiteLayout
  locale={locale}
  path={path}
  title={`${title} | USM Football`}
  general={content.general}
  social={content.social}
  jsonLd={jsonLd}
  ogImage={service.image_url}
>
  <ServicePage locale={locale} content={content} service={service} />
</SiteLayout>
