---
import type { Locale } from "@/lib/i18n";
import type { SiteContent } from "@/lib/types";

interface Props {
  locale: Locale;
  content: SiteContent;
}

// Contenu légal volontairement conservé en français pour toutes les langues.
const { locale, content } = Astro.props;
---

