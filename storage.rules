rules_version = '2';

// Règles Storage — site vitrine USM Football
// Lecture publique (images affichées sur le site), écriture réservée aux
// utilisateurs authentifiés, limitée aux images de moins de 10 Mo.
// Chemins utilisés par l'admin : services/, site/, presse/, marquee/, et
// les images de joueurs à la racine.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
